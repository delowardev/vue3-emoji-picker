{
  "name": "vue3-emoji-picker",
  "version": "2.0.0",
  "license": "MIT",
  "author": "delowardev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delowardev/vue3-emoji-picker.git"
  },
  "bugs": {
    "url": "https://github.com/delowardev/vue3-emoji-picker/issues"
  },
  "homepage": "https://github.com/delowardev/vue3-emoji-picker/",
  "keywords": [
    "vue3-emoji-picker",
    "emoji-picker",
    "emoji"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist"
  ],
  "main": "./dist/emoji-picker.cjs",
  "module": "./dist/emoji-picker.mjs",
  "unpkg": "./dist/emoji-picker.umd.js",
  "jsdelivr": "./dist/emoji-picker.umd.js",
  "types": "./dist/emoji-picker.d.cts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/emoji-picker.d.mts",
        "default": "./dist/emoji-picker.mjs"
      },
      "require": {
        "types": "./dist/emoji-picker.d.cts",
        "default": "./dist/emoji-picker.cjs"
      },
      "default": "./dist/emoji-picker.mjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json",
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "default": "./dist/core.mjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "serve": "vite preview",
    "prepare": "husky",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier -c --ignore-unknown ./src",
    "prettier:fix": "prettier --write --ignore-unknown ./src",
    "test": "vitest",
    "test:once": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ssr": "node scripts/smoke-ssr.mjs",
    "test:pack": "node scripts/check-package.mjs",
    "check:publish": "publint && attw --pack . --entrypoints . && attw --pack . --entrypoints ./core --profile node16",
    "precommit": "npm run type-check && npm run prettier:fix && npm run lint:fix && npm run build",
    "prepublishOnly": "npm run test:once && npm run build && npm run check:publish && npm run test:ssr && npm run test:pack",
    "demo:build": "vite build --config vite.demo.config.ts",
    "data:update": "node scripts/update-emoji-data.mjs"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,ts,css,md,vue}": "prettier --write"
  },
  "peerDependencies": {
    "vue": "^3.2.23"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
