{
  "name": "vue3-emoji-picker",
  "version": "1.2.0",
  "license": "MIT",
  "author": "delowardev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delowardev/vue3-emoji-picker.git"
  },
  "bugs": {
    "url": "https://github.com/delowardev/vue3-emoji-picker/issues"
  },
  "homepage": "https://github.com/delowardev/vue3-emoji-picker/",
  "keywords": [
    "vue3-emoji-picker",
    "emoji-picker",
    "emoji"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist"
  ],
  "main": "./dist/emoji-picker.cjs",
  "module": "./dist/emoji-picker.mjs",
  "types": "./dist/emoji-picker.d.cts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/emoji-picker.d.mts",
        "default": "./dist/emoji-picker.mjs"
      },
      "require": {
        "types": "./dist/emoji-picker.d.cts",
        "default": "./dist/emoji-picker.cjs"
      },
      "default": "./dist/emoji-picker.mjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild-dts.mjs",
    "serve": "vite preview",
    "prepare": "husky install",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint --ext .ts,.js,.vue ./",
    "lint:fix": "eslint --fix --ext .ts,.js,.vue ./",
    "prettier": "prettier -c --ignore-unknown ./src",
    "prettier:fix": "prettier --write --ignore-unknown ./src",
    "test": "vitest",
    "test:once": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ssr": "node scripts/smoke-ssr.mjs",
    "test:pack": "node scripts/check-package.mjs",
    "check:publish": "publint && attw --pack . --exclude-entrypoints ./css",
    "precommit": "npm run type-check && npm run prettier:fix && npm run lint:fix && npm run build",
    "prepublishOnly": "npm run test:once && npm run build && npm run check:publish && npm run test:ssr && npm run test:pack"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,ts,css,md,vue}": "prettier --write"
  },
  "peerDependencies": {
    "vue": "^3.2.23"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/types": "^7.15.6",
    "@types/node": "^16.11.7",
    "@typescript-eslint/parser": "^5.5.0",
    "@vitejs/plugin-vue": "^1.2.5",
    "@vitest/coverage-c8": "^0.24.5",
    "@vue/compiler-sfc": "^3.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.3.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-vue": "^8.1.1",
    "happy-dom": "^12.10.3",
    "husky": "^7.0.4",
    "lint-staged": ">=10",
    "prettier": "^2.5.0",
    "publint": "^0.3.25",
    "sass": "^1.43.2",
    "typescript": "^4.3.2",
    "vite": "^2.4.2",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^0.24.5",
    "vue": "^3.2.23",
    "vue-eslint-parser": "^8.0.1",
    "vue-tsc": "^1.2.1"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.0"
  }
}
